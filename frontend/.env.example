# Where the Vite dev server proxies /api requests (development only).
VITE_API_PROXY_TARGET=http://localhost:8080
# Base URL the built app calls. Leave as /api when the frontend is served behind the same origin/proxy.
VITE_API_BASE_URL=/api
# Hide the demo-account shortcuts on the login page.
# VITE_SHOW_DEMO_ACCOUNTS=false
