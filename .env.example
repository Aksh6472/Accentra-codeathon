# Copy to .env and adjust. docker-compose reads DB_* values; the backend reads all of them.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leave_management
DB_USERNAME=leave_user
DB_PASSWORD=leave_password

# Base64-encoded secret of at least 256 bits. Generate with: openssl rand -base64 48
APP_JWT_SECRET=
APP_JWT_EXPIRATION_MINUTES=480

# Initial workflow settings (seeded once; HR can change them later in the UI)
APP_ESCALATION_TIMEOUT_MINUTES=1440
APP_TEAM_ABSENCE_THRESHOLD_PERCENT=30
APP_ESCALATION_CHECK_INTERVAL_MS=60000

# Demo data
APP_SEED_ENABLED=true
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
